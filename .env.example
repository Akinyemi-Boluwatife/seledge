# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=seledge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seledge
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- App ---
# Prisma reads DATABASE_URL. Must match the Postgres values above.
DATABASE_URL=postgresql://seledge:change-me@localhost:5432/seledge?schema=public
PORT=3000

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-32-plus-char-secret
JWT_EXPIRES_IN_SECONDS=900
WEBHOOK_SECRET=replace-with-a-random-32-plus-char-secret
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
